# Blogger API (Phase 3 import) — keep these out of version control
# Copy to .env.development and fill in real values. Never commit secrets.

# Google Cloud OAuth 2.0 client (Desktop app), with the Blogger API enabled.
# Register the redirect URI used by scripts/blogger/oauth.ts:
#   http://localhost:8765/
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=

# Not obtainable from the Blogger API itself. Run `pnpm blogger:oauth` once,
# authorize in the browser, and the script writes the refresh token here.
# It is issued by Google on first consent (access_type=offline), not by Blogger.
BLOGGER_REFRESH_TOKEN=

# Optional: port used by `pnpm blogger:oauth` for the local redirect server.
BLOGGER_OAUTH_PORT=8765

# Per-publication Blogger blog IDs and blog URLs (Phase 3 import).
# These configure the Blogger integration; they are NOT part of the Publication
# data model (src/lib/publications). src/lib/blogger/config.ts derives the key
# from the publication slug:
#   BLOGGER_<SLUG_UPPER_SNAKE_CASE>_BLOG_ID / _BLOG_URL
# Fill in real values in .env.development. Blog IDs are not secrets, but keep
# them here so the public site code never hard-codes Blogger integration data.
# _BLOG_ID must be a numeric string; _BLOG_URL should be a full https:// URL.
# _BLOG_URL is optional for the import (used by future redirect/canonical work).
BLOGGER_THE_SORE_TRANSITION_BLOG_ID=
BLOGGER_THE_SORE_TRANSITION_BLOG_URL=
BLOGGER_THE_REBELLIOUS_FLAME_BLOG_ID=
BLOGGER_THE_REBELLIOUS_FLAME_BLOG_URL=
BLOGGER_MY_SOULFUL_INCANTATIONS_BLOG_ID=
BLOGGER_MY_SOULFUL_INCANTATIONS_BLOG_URL=

# Cloudflare backend (Phase 5) — placeholders only, never real values.
# AUTH_SECRET is read by `wrangler dev` from .dev.vars (gitignored); it signs
# CMS session cookies (Phase 4). Generate with: openssl rand -hex 32
AUTH_SECRET=

# Admin bootstrap for the D1 seed script (scripts/db/seed-admin.ts, Phase 5 M1.3).
# Never defaulted and never printed; used only to create the initial admin user.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Build-time content export (scripts/export-content.ts, Phase 5 M2.2).
# EXPORT_CONTENT_MODE=local (default) exports via local Miniflare;
# EXPORT_CONTENT_MODE=remote fetches EXPORT_CONTENT_URL (the deployed
# GET /api/content endpoint).
EXPORT_CONTENT_MODE=local
EXPORT_CONTENT_URL=
