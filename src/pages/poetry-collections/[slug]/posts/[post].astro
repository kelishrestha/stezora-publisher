---
import BlogLayout from '../../../../layouts/BlogLayout.astro';
import { sanitizeContentHtml } from '../../../../lib/blogger/sanitize';
import { getPublishedPosts } from '../../../../lib/publications/collections';
import { getPublication } from '../../../../lib/publications';
import { imageVariant } from '../../../../lib/publications/images';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts
		.filter((post) => getPublication(post.data.publication))
		.map((post) => ({
			params: { slug: post.data.publication, post: post.id },
			props: { post },
		}));
}

const { slug } = Astro.params;
const { post } = Astro.props;

const publication = getPublication(slug);
if (!publication) {
	throw new Error(`Publication not found: ${slug}`);
}

const content = sanitizeContentHtml(post.data.content);
---

<BlogLayout post={post} publication={publication}>
	{
		post.data.featuredImage && (
			<span class="img-shell mb-8 block w-full rounded-lg border border-border shadow-lg lg:sticky lg:top-20 lg:z-30 lg:float-right lg:mb-6 lg:ml-10 lg:w-80 lg:rotate-2 lg:transition-transform lg:hover:rotate-0">
				<span class="img-shell-dots" aria-hidden="true"><span></span><span></span><span></span></span>
				{/* m-0 and block cancel the prose image margins and the inline
				    baseline gap, so the picture fills the frame edge to edge. */}
				<img src={imageVariant(post.data.featuredImage, 1024)} alt="" class="m-0 block w-full" loading="lazy" />
			</span>
		)
	}
	<Fragment set:html={content} />
</BlogLayout>
