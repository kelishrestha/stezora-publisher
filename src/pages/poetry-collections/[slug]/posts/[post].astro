---
import BlogLayout from '../../../../layouts/BlogLayout.astro';
import { sanitizeContentHtml } from '../../../../lib/blogger/sanitize';
import { getPublishedPosts } from '../../../../lib/publications/collections';
import { getPublication } from '../../../../lib/publications';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts
		.filter((post) => getPublication(post.data.publication))
		.map((post) => ({
			params: { slug: post.data.publication, post: post.id },
			props: { post },
		}));
}

const { slug } = Astro.params;
const { post } = Astro.props;

const publication = getPublication(slug);
if (!publication) {
	throw new Error(`Publication not found: ${slug}`);
}

const content = sanitizeContentHtml(post.data.content);
---

<BlogLayout post={post} publication={publication}>
	{
		post.data.featuredImage && (
			<span class="img-shell mb-8 block w-full rounded-lg border border-border shadow-lg lg:float-right lg:mb-6 lg:ml-10 lg:w-80 lg:rotate-2 lg:transition-transform lg:hover:rotate-0">
				<img
					src={post.data.featuredImage}
					alt=""
					class="w-full"
					loading="eager"
					onload="this.classList.add('loaded')"
				/>
			</span>
		)
	}
	<Fragment set:html={content} />
</BlogLayout>
