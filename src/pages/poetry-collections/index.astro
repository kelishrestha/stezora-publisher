---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationShowcase from '../../components/publication/PublicationShowcase';
import { getPostsForPublication } from '../../lib/publications/collections';
import { PUBLICATIONS_PATH, getPublications, publicationPath } from '../../lib/publications';

const publications = await Promise.all(
	getPublications().map(async (publication) => {
		const posts = await getPostsForPublication(publication.slug);
		return {
			name: publication.name,
			slug: publication.slug,
			description: publication.description,
			accent: publication.accent,
			postCount: posts.length,
			postTitles: posts.slice(0, 8).map((post) => post.data.title),
		};
	})
);
---

<BaseLayout title="Poetry Collections" description="All poetry collections on this site." path={PUBLICATIONS_PATH}>
	<div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
		<header>
			<p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">All Poetry Collections</p>
			<h1 class="mt-2 font-serif text-3xl font-bold tracking-tight sm:text-4xl">Browse poetry collections</h1>
			<p class="mt-3 max-w-2xl text-muted-foreground">
				Three distinct voices, one shared home. Pick a poem collection from the shelf to read its latest writing.
			</p>
		</header>
		<div class="mt-10">
			<PublicationShowcase client:load publications={publications} />
		</div>
	</div>
</BaseLayout>
