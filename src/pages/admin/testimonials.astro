---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Testimonials from '../../components/admin/Testimonials';

const title = 'Testimonials';
const description = 'Reader testimonials shown on the homepage.';
---

<AdminLayout title={title} description={description} path="/admin/testimonials" breadcrumbs={[{ name: 'Dashboard', href: '/admin' }, { name: 'Testimonials' }]}>
	<h1 class="text-2xl font-semibold tracking-tight text-foreground">Testimonials</h1>
	<p class="mt-1 text-sm text-muted-foreground">Reader stories shown in the homepage carousel. They publish on the next build.</p>
	<div class="mt-6">
		<Testimonials client:load />
	</div>
</AdminLayout>
