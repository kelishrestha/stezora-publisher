---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import MediaManager from '../../../components/admin/MediaManager';

const title = 'Media';
const description = 'Upload and manage media for your posts.';
---

<AdminLayout title={title} description={description} path="/admin/media" breadcrumbs={[{ name: 'All media' }]}>
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h1 class="text-2xl font-semibold tracking-tight text-foreground">Media</h1>
		<button
			type="button"
			id="upload-media-button"
			class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-on-accent transition-colors hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-background"
		>
			Upload media
		</button>
	</div>
	<p class="mt-1 text-sm text-muted-foreground">Upload images and documents. Files are stored in R2, metadata in D1.</p>
	<div class="mt-6">
		<MediaManager client:load />
	</div>
</AdminLayout>