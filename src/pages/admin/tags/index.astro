---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import TagManager from '../../../components/admin/TagManager';

const title = 'Tags';
const description = 'Manage tags per publication.';
---

<AdminLayout title={title} description={description} path="/admin/tags" breadcrumbs={[{ name: 'All tags' }]}>
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h1 class="text-2xl font-semibold tracking-tight text-foreground">Tags</h1>
		<button
			type="button"
			id="new-tag-button"
			class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-on-accent transition-colors hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-background"
		>
			New tag
		</button>
	</div>
	<p class="mt-1 text-sm text-muted-foreground">Tags belong to one publication. Delete is blocked while a post uses one.</p>
	<div class="mt-6">
		<TagManager client:load />
	</div>
</AdminLayout>
