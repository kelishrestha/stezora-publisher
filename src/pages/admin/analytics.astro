---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Analytics from '../../components/admin/Analytics';

const title = "Writer's Analytics";
const description = 'Charts of your publishing activity, status mix, and media storage.';
---

<AdminLayout
	title={title}
	description={description}
	path="/admin/analytics"
	breadcrumbs={[{ name: 'Dashboard', href: '/admin' }, { name: "Writer's Analytics" }]}
>
	<h1 class="text-2xl font-semibold tracking-tight text-foreground">Writer's Analytics</h1>
	<p class="mt-1 text-sm text-muted-foreground">
		Publishing activity, status mix, and media storage, drawn from your content.
	</p>
	<div class="mt-6">
		<Analytics client:load />
	</div>
</AdminLayout>
