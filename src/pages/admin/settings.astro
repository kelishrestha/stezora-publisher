---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Settings from '../../components/admin/Settings';

const title = 'Settings';
const description = 'Admin account and application settings.';
---

<AdminLayout title={title} description={description} path="/admin/settings" breadcrumbs={[{ name: 'Settings' }]}>
	<h1 class="text-2xl font-semibold tracking-tight text-foreground">Settings</h1>
	<p class="mt-1 text-sm text-muted-foreground">Manage your admin account.</p>
	<div class="mt-6">
		<Settings client:load />
	</div>
</AdminLayout>
