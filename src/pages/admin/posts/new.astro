---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostEditor from '../../../components/admin/PostEditor';

const title = 'New post';
const description = 'Create a new post.';
---

<AdminLayout title={title} description={description} path="/admin/posts">
	<h1 class="text-2xl font-semibold tracking-tight text-foreground">New post</h1>
	<p class="mt-1 text-sm text-muted-foreground">Write your post, choose a publication, and save or publish.</p>
	<div class="mt-6">
		<PostEditor client:load />
	</div>
</AdminLayout>
