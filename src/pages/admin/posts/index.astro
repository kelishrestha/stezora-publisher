---
import { Icon } from 'astro-icon/components';
import { buttonClass } from '../../../components/ui/shared/classes';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostList from '../../../components/admin/PostList';

const title = 'Posts';
const description = 'Manage posts across all publications.';
---

<AdminLayout title={title} description={description} path="/admin/posts" breadcrumbs={[{ name: 'All posts' }]}>
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h1 class="text-2xl font-semibold tracking-tight text-foreground">Posts</h1>
		<a
			href="/admin/posts/new"
			class={buttonClass('primary')}
		>
			<Icon name="lucide:plus" class="size-4" aria-hidden="true" />
			New post
		</a>
	</div>
	<p class="mt-1 text-sm text-muted-foreground">Write once, publish to any publication.</p>
	<div class="mt-6">
		<PostList client:load />
	</div>
</AdminLayout>
