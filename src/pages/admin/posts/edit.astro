---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostEditor from '../../../components/admin/PostEditor';

const title = 'Edit post';
const description = 'Edit an existing post.';
---

<!--
	This is intentionally a STATIC page. The post id is read from the URL by
	PostEditor on the client (Worker rewrites /admin/posts/:id/edit to this
	asset, DEVELOPER.md §70), so the route needs no Server-side rendering and
	the URL scheme /admin/posts/:id/edit stays intact.
-->
<AdminLayout title={title} description={description} path="/admin/posts">
	<h1 class="text-2xl font-semibold tracking-tight text-foreground">Edit post</h1>
	<p class="mt-1 text-sm text-muted-foreground">Update your post and save or publish.</p>
	<div class="mt-6">
		<PostEditor client:load />
	</div>
</AdminLayout>