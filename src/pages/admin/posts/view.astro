---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostView from '../../../components/admin/PostView';

const title = 'View post';
const description = 'View a post.';
---

<!--
	Static shell. The post id is read from the URL by PostView on the client
	(Worker rewrites /admin/posts/:id/view to this asset, DEVELOPER.md §70),
	so the URL scheme /admin/posts/:id/view stays intact.
-->
<AdminLayout title={title} description={description} path="/admin/posts">
	<h1 class="sr-only">View post</h1>
	<PostView client:load />
</AdminLayout>