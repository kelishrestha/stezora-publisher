---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import PublicationCard from '../components/publication/PublicationCard.astro';
import { SITE } from '../lib/seo/config';
import { getPublishedPosts } from '../lib/publications/collections';
import { getPublication, getPublications, postPath } from '../lib/publications';

const allPublications = getPublications();
const latestPosts = (await getPublishedPosts()).slice(0, 5);

function displayDate(date: Date): string {
	return date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout path="/">
	<Container class="py-16">
		<section class="mb-16 text-center">
			<h1 class="font-serif text-4xl font-bold tracking-tight sm:text-5xl">{SITE.name}</h1>
			<p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">{SITE.description}</p>
		</section>

		<section class="mb-16">
			<h2 class="font-serif text-2xl font-semibold">Publications</h2>
			<div class="mt-6 grid gap-6 sm:grid-cols-3">
				{allPublications.map((publication) => (
					<PublicationCard publication={publication} />
				))}
			</div>
		</section>

		<section class="mb-16">
			<h2 class="font-serif text-2xl font-semibold">Latest writing</h2>
			<ul class="mt-6 space-y-6">
				{latestPosts.map((post) => {
					const publication = getPublication(post.data.publication);
					return (
						<li class="border-b border-slate-200 pb-6 last:border-b-0 dark:border-slate-800">
							<p class="text-xs font-medium uppercase tracking-widest text-slate-400 dark:text-slate-500">
								{publication?.name ?? post.data.publication}
							</p>
							<h3 class="mt-1 font-serif text-xl font-semibold leading-snug">
								<a
									href={postPath(post.data.publication, post.id)}
									class="transition-colors hover:text-slate-600 dark:hover:text-slate-300"
								>
									{post.data.title}
								</a>
							</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{post.data.excerpt}</p>
							<time class="mt-2 block text-sm text-slate-500 dark:text-slate-400" datetime={post.data.pubDate.toISOString()}>
								{displayDate(post.data.pubDate)}
							</time>
						</li>
					);
				})}
			</ul>
		</section>

		<section class="border-t border-slate-200 pt-10 text-sm text-slate-500 dark:border-slate-800 dark:text-slate-400">
			<p>Subscribe via <a href="/rss.xml" class="underline decoration-slate-300 underline-offset-2 hover:text-slate-900 dark:decoration-slate-700 dark:hover:text-white">RSS</a>.</p>
		</section>
	</Container>
</BaseLayout>
