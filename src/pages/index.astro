---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { SITE } from '../lib/seo/config';
---

<BaseLayout path="/">
	<Container class="py-16">
		<section class="mb-16 text-center">
			<h1 class="font-serif text-4xl font-bold tracking-tight sm:text-5xl">{SITE.name}</h1>
			<p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">{SITE.description}</p>
		</section>

		<section class="mb-16 grid gap-6 sm:grid-cols-3">
			<Card class="flex flex-col">
				<h2 class="font-serif text-xl font-semibold">Publications</h2>
				<p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-300">
					Three distinct publications, one place to read them all.
				</p>
				<Button href="/about" variant="secondary" class="mt-4">Coming soon</Button>
			</Card>
			<Card class="flex flex-col">
				<h2 class="font-serif text-xl font-semibold">Latest writing</h2>
				<p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-300">
					New articles will appear here in Phase 2.
				</p>
				<Button href="/about" variant="secondary" class="mt-4">Read more</Button>
			</Card>
			<Card class="flex flex-col">
				<h2 class="font-serif text-xl font-semibold">About</h2>
				<p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-300">
					One author, three publications, a shared home.
				</p>
				<Button href="/about" variant="secondary" class="mt-4">Learn more</Button>
			</Card>
		</section>

		<section class="border-t border-slate-200 pt-10 text-sm text-slate-500 dark:border-slate-800 dark:text-slate-400">
			<p>Subscribe via <a href="/rss.xml" class="underline decoration-slate-300 underline-offset-2 hover:text-slate-900 dark:decoration-slate-700 dark:hover:text-white">RSS</a>.</p>
		</section>
	</Container>
</BaseLayout>
