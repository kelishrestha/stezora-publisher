---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import LikeButton from '../components/blog/LikeButton.astro';
import { slugify } from '../lib/publications';

// Reader testimonials are admin-authored (raised from contact-form emails) and
// baked in at build; the section is omitted entirely when there are none.
const testimonials = (await getCollection('testimonials')).map((entry) => entry.data).sort((a, b) => a.sortOrder - b.sortOrder);
const books = [
	{
		title: 'The Warrior Must Rise',
		subtitle: 'A Short Story of a Warrior',
		description: 'The journey of a warrior from cold ashes to rising phoenix.',
		genre: 'Self-help',
		pages: 56,
		rating: 4.8,
		reviews: 1200,
		price: '$18.99',
		image: '/the-warrior-must-rise-cover.png',
		href: '/poetry-collections/the-rebellious-flame',
	},
	{
		title: 'The Peach Fall',
		subtitle: 'A Story of a Girl',
		description: 'The inside journey of a girl who struggles to live by her own. Dedicated to all the people suffering from loneliness and depression. Things are not as bad as it seems when you start believe in yourself that you can live by yourself.',
		genre: 'Self-help',
		pages: 56,
		rating: 4.8,
		reviews: 1200,
		price: '$14.99',
		image: '/the-peach-fall-cover.jpg',
		href: '/poetry-collections/the-sore-transition',
	},
];
const poemCollections = [
	{ title: 'The Sore Transitions', subtitle: 'Reflecting raw truths of soul journey', description: 'A collection of poems that explore the tender spaces between darkness and light, offering solace to those who find themselves awake in the quiet hours.', theme: 'Innocence & Solitude', poemCount: 29, rating: 4.9, reviews: 328, preview: ['The cold breeze swinging by the window', 'The spasmodic flow makes me freeze for a while'], icon: 'lucide:moon', href: '/poetry-collections/the-sore-transition' },
	{ title: 'The Rebellious Flame', subtitle: 'The Rebellious against the world', description: "The poems that chart the unexplored regions of the heart, from first love's trembling shores to the deep valleys of loss and the mountains of healing.", theme: 'Love & Loss', poemCount: 30, rating: 4.8, reviews: 567, preview: ["My shadow's engraved into the shiny road", 'No lights, no sorrows to be afraid of'], icon: 'lucide:heart', href: '/poetry-collections/the-rebellious-flame' },
	{ title: 'The Soulful Incantations', subtitle: 'Poems of Soul Transformation', description: 'Soul-driven profound pieces that explore the liminal spaces of existence—the moments between what was and what might be, where transformation quietly blooms.', theme: 'Change & Growth', poemCount: 12, rating: 4.7, reviews: 234, preview: ['Blue waves from the ocean', 'Makes me stay a little longer on the shore'], icon: 'lucide:feather', href: '/poetry-collections/my-soulful-incantations' },
];

const contactControl =
	'w-full rounded-lg border border-border bg-background px-4 py-3 transition-all duration-300 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/50';

// Staggered reveal delays for the poetry-collection cards. Kept as literal
// class strings (not an inline style) so the CSP stays hash-locked with no
// inline style attributes; Tailwind scans these literals at build time.
const cardDelays = ['[animation-delay:0ms]', '[animation-delay:400ms]', '[animation-delay:800ms]'];
---

<BaseLayout path="/">
	<!-- HyperUI banner (left content, image right) on theme tokens. -->
	<section class="relative overflow-hidden">
		<div class="home-float absolute left-1/4 top-1/4 h-40 w-40 rounded-full bg-accent-soft/40 blur-3xl" aria-hidden="true"></div>
		<div class="home-float absolute bottom-1/4 right-1/4 h-56 w-56 rounded-full bg-primary/10 blur-3xl [animation-delay:-3s]" aria-hidden="true"></div>
		<div class="relative mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 md:grid md:grid-cols-2 md:items-center md:gap-8 lg:px-8 lg:py-14">
			<div class="max-w-prose text-left">
				<p class="home-fade-up text-xs font-medium uppercase tracking-[0.25em] text-muted-foreground">
					Stezora &middot; Soul Writer &amp; Keeper of Stories
				</p>
				<h1 class="home-fade-up mt-6 font-serif text-4xl tracking-wide text-foreground sm:text-5xl [animation-delay:120ms]">
					Words are the windows to the <strong class="font-serif text-primary">soul's</strong> deepest chambers
				</h1>
				<p class="home-fade-up mt-6 text-base text-pretty leading-relaxed text-muted-foreground sm:text-lg [animation-delay:240ms]">
					Stezora writes soul-driven poems and stories of mystery, empathy, and transformation: three poetry
					collections and two published books, written low and slow for readers who find themselves awake in the
					quiet hours.
				</p>
				<div class="home-fade-up mt-8 flex flex-wrap gap-4 [animation-delay:360ms]">
					<a
						href="/poetry-collections"
						class="inline-flex items-center gap-2.5 rounded-full bg-foreground px-8 py-4 text-base text-background transition-transform duration-300 hover:scale-105"
					>
						<Icon name="lucide:feather" class="h-5 w-5" aria-hidden="true" />
						Explore poetry collections
					</a>
					<a
						href="/publications"
						class="inline-flex items-center gap-2.5 rounded-full border border-border px-8 py-4 text-base transition-colors hover:bg-surface-elevated"
					>
						<Icon name="lucide:book-open" class="h-5 w-5" aria-hidden="true" />
						Browse books
					</a>
				</div>
			</div>
			<div class="relative mx-auto mt-12 hidden h-[28rem] w-full max-w-lg md:mt-0 md:block" aria-hidden="true">
				<img
					src="/the-peach-fall-cover.jpg"
					alt=""
					loading="eager"
					class="home-fade-up absolute left-2 top-8 w-64 -rotate-6 rounded-lg border border-border shadow-xl"
				/>
				<img
					src="/the-warrior-must-rise-cover.png"
					alt=""
					loading="eager"
					class="home-fade-up absolute right-2 top-0 w-64 rotate-6 rounded-lg border border-border shadow-xl [animation-delay:180ms]"
				/>
			</div>
		</div>
	</section>

	<Container class="space-y-28 py-20 sm:py-28">
		<section id="about" class="home-fade-up scroll-mt-24">
			<div class="mx-auto max-w-3xl text-center">
				<div class="mb-6 flex items-center justify-center gap-3 text-muted-foreground" aria-hidden="true"><span class="h-px w-16 bg-current/40"></span><Icon name="lucide:heart" class="h-5 w-5 animate-pulse" /><span class="h-px w-16 bg-current/40"></span></div>
				<h2 class="font-serif text-4xl md:text-5xl">About the Writer</h2>
				<p class="mt-6 max-w-3xl mx-auto font-serif text-lg leading-relaxed text-foreground/90">
					I write under the name Stezora, a name that holds the essence of my soul's journey—soft,
					rebellious, mystical, and ever-evolving. Writing has always been my way of breathing through
					the chaos, of turning silence into meaning.
				</p>
			</div>

			<div class="mt-12 grid gap-6 sm:grid-cols-3 mx-32">
				{[
					['Mystery', 'Every story holds secrets waiting to be discovered. In shadows and silence, truth reveals itself to those who dare to look deeper.'],
					['Empathy', 'To write is to feel the heartbeat of humanity. Each character carries a piece of our shared existence, our joys and sorrows intertwined.'],
					['Soul', "Words are vessels for the soul's journey. Through language, we transcend the ordinary and touch the infinite within us all."],
				].map(([title, description]) => (
					<article class="group rounded-lg border border-border bg-surface p-6 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
						<div class="mx-auto mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-surface-elevated text-accent-foreground">
							<Icon name={title === 'Mystery' ? 'lucide:moon' : title === 'Empathy' ? 'lucide:heart' : 'lucide:sparkles'} class="h-5 w-5" aria-hidden="true" />
						</div>
						<h3 class="font-serif text-xl">{title}</h3>
						<p class="mt-3 p-1 font-light leading-relaxed text-muted-foreground">{description}</p>
					</article>
				))}
			</div>
			<div class="mt-16 border-t border-border pt-12 mx-32">
				<div class="text-center">
					<Icon name="lucide:book-open" class="mx-auto mb-4 h-8 w-8 animate-pulse text-muted-foreground" aria-hidden="true" />
					<h3 class="font-serif text-2xl">Writing Philosophy</h3>
				</div>
				<div class="mt-8 grid gap-8 md:grid-cols-2">
					<blockquote class="font-serif text-xl italic leading-relaxed text-foreground/80">“I write to understand, to remember, and to share the hidden truths I find between the lines of existence.”</blockquote>
					<div class="space-y-4 leading-relaxed text-muted-foreground">
						<p>Writing is not about instruction — it is about invitation. Each word is chosen not to teach, but to reach: the quiet grief, the unspoken longing, the tender parts we often hide.</p>
						<p>I write slowly, intentionally, so that even one person may feel seen, soothed, or reminded of their own inner voice.</p>
					</div>
				</div>
			</div>
		</section>

		<section id="books" class="home-fade-up scroll-mt-24">
			<div class="mx-auto max-w-3xl text-center">
				<p class="text-xs font-medium uppercase tracking-[0.25em] text-muted-foreground">Stories That Transform</p>
				<h2 class="mt-2 font-serif text-4xl md:text-5xl">Published Works</h2>
				<p class="mt-5 text-muted-foreground">Stories that navigate the depths of human experience, each one a journey into the mysteries of the heart.</p>
			</div>
			<div class="mt-10 space-y-12">
				{books.map((book, index) => (
					<article class={`group grid items-center gap-10 lg:grid-cols-2 ${index % 2 ? 'lg:grid-flow-col-dense' : ''}`}>
						<div class={`flex justify-center ${index % 2 ? 'lg:col-start-2' : ''}`}>
							<div class="relative transition-transform duration-500 group-hover:scale-105">
								<img src={book.image} alt={`${book.title} cover`} class="h-80 w-64 rounded-lg object-cover shadow-2xl" />
								<span class="absolute -bottom-4 -right-4 flex h-16 w-16 items-center justify-center rounded-full border-4 border-border bg-background text-red-500 shadow-lg"><svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true"><path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" /></svg></span>
							</div>
						</div>
						<div class={`space-y-6 ${index % 2 ? 'lg:col-start-1 lg:row-start-1' : ''}`}>
							<div class="flex items-center gap-4">
								<span class="rounded-full bg-muted px-3 py-1 text-xs uppercase text-black tracking-widest">{book.genre}</span>
								<span class="flex items-center gap-1 text-sm text-muted-foreground"><Icon name="lucide:clock-3" class="h-4 w-4" aria-hidden="true" /> {book.pages} pages</span>
							</div>
							<h3 class="font-serif text-3xl">{book.title}</h3>
							<p class="text-lg text-muted-foreground">{book.subtitle}</p>
							<p class="leading-relaxed text-foreground/80">{book.description}</p>
							<div class="flex items-center gap-2 text-yellow-500"><span class="flex" aria-label={`${book.rating} out of 5 stars`}>{[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>)}</span><span class="text-sm text-foreground">{book.rating} <span class="text-muted-foreground">({book.reviews} reviews)</span></span></div>
							<div class="flex items-center justify-between border-t border-border pt-4">
								<span class="flex items-center gap-4"><span class="font-serif text-2xl">{book.price}</span><LikeButton type="book" id={slugify(book.title)} label={book.title} /></span>
								<span class="flex items-center gap-3">
									<button
										type="button"
										disabled
										class="inline-flex cursor-not-allowed items-center gap-2 rounded-full bg-foreground px-6 py-3 text-sm text-background opacity-50"
									>
										<Icon name="lucide:book-heart" class="h-4 w-4" aria-hidden="true" />
										Purchase Book
									</button>
									<span class="text-xs italic text-muted-foreground">Coming soon</span>
								</span>
							</div>
						</div>
					</article>
				))}
			</div>
			<div class="mt-10 text-center"><a href="/publications" class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-3 text-sm transition-colors hover:bg-surface-elevated">See all publications <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" /></a></div>
		</section>

		<section id="poems" class="home-fade-up scroll-mt-24">
			<div class="mx-auto max-w-3xl text-center">
				<p class="text-xs font-medium uppercase tracking-[0.25em] text-muted-foreground">Words for the Soul</p>
				<h2 class="mt-2 font-serif text-4xl md:text-5xl">Poetry Collections</h2>
				<p class="mt-5 text-muted-foreground">Verses that capture the ineffable moments of human experience, each collection a journey through the landscape of the soul</p>
			</div>
			<div class="mt-10 grid gap-12 md:grid-cols-3">
				{poemCollections.map((collection, index) => (
					<article class={`home-float group relative overflow-hidden rounded-lg border border-border bg-surface p-6 transition-all duration-500 hover:scale-105 hover:shadow-xl ${cardDelays[index % cardDelays.length]}`}>
						<div class="text-center">
							<div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-muted transition-colors group-hover:bg-accent"><Icon name={collection.icon} class="h-6 w-6 text-primary" aria-hidden="true" /></div>
							<h3 class="font-serif text-2xl">{collection.title}</h3>
							<p class="mt-2 text-muted-foreground">{collection.subtitle}</p>
							<div class="mt-3 flex items-center justify-center gap-4 text-sm">
								<span class="rounded-full bg-secondary px-2 py-1 text-xs">{collection.theme}</span>
								<span class="text-gray-600">{collection.poemCount} poems</span>
							</div>
						</div>
						<div class="mt-6 rounded-lg bg-secondary/20 p-4"><p class="mb-2 text-xs uppercase tracking-widest text-muted-foreground">Preview</p><div class="space-y-1 font-serif italic text-foreground/70">{collection.preview.map((line) => <p class="text-sm">{line}</p>)}<p class="text-xs text-muted-foreground">Click to read more...</p></div></div>
						<div class="mt-4 flex items-center gap-2 text-sm text-yellow-500"><span class="flex" aria-label={`${collection.rating} out of 5 stars`}>{[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>)}</span><span class="text-foreground">{collection.rating}</span><span class="text-muted-foreground">({collection.reviews} reviews)</span></div>
						<div class="mt-4 flex justify-end border-t border-border pt-4"><a href={collection.href} class="inline-flex items-center gap-2 rounded-full bg-foreground px-4 py-2 text-sm text-background transition-transform duration-300 hover:scale-105">View <Icon name="lucide:book-open-text" class="h-4 w-4" aria-hidden="true" /></a></div>
						<div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-transparent to-secondary/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
					</article>
				))}
			</div>
			<div class="mt-10 text-center"><a href="/poetry-collections" class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-3 text-sm transition-colors hover:bg-surface-elevated">See all poetry collections <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" /></a></div>
		</section>

		<section id="testimonials" class="home-fade-up scroll-mt-24">
			{testimonials.length > 0 && (
			<Fragment>
			<div class="mx-auto max-w-3xl text-center">
				<div class="mb-6 flex items-center justify-center gap-3 text-muted-foreground" aria-hidden="true"><span class="h-px w-16 bg-current/40"></span><Icon name="lucide:heart" class="h-5 w-5 animate-pulse" /><span class="h-px w-16 bg-current/40"></span></div>
				<h2 class="font-serif text-4xl md:text-5xl">Reader Voices</h2>
				<p class="mt-5 text-muted-foreground">Stories shared by souls who have journeyed through these pages and found pieces of themselves within.</p>
			</div>
			<div class="relative mt-10">
				<div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-secondary/30 to-accent-soft/20 p-8 md:p-12">
					<div class="absolute left-4 top-4 text-secondary/40" aria-hidden="true"><Icon name="lucide:quote" class="h-16 w-16" /></div>
					<div class="absolute right-4 top-4 flex gap-2">
						<button type="button" data-voice-prev class="group rounded-full bg-background/80 p-2 transition-colors duration-300 hover:bg-background" aria-label="Previous testimonial"><Icon name="lucide:chevron-left" class="h-5 w-5 transition-colors duration-300 group-hover:text-primary" aria-hidden="true" /></button>
						<button type="button" data-voice-next class="group rounded-full bg-background/80 p-2 transition-colors duration-300 hover:bg-background" aria-label="Next testimonial"><Icon name="lucide:chevron-right" class="h-5 w-5 transition-colors duration-300 group-hover:text-primary" aria-hidden="true" /></button>
					</div>
					<div class="relative z-10 mx-auto max-w-4xl">
						{testimonials.map((voice, index) => (
							<div data-voice-slide class={index === 0 ? '' : 'hidden'}>
								<div class="mb-6 flex justify-center" aria-label={`${voice.rating} out of 5 stars`}>{[1, 2, 3, 4, 5].map((n) => <svg viewBox="0 0 24 24" fill="currentColor" class={`h-6 w-6 ${n <= voice.rating ? 'text-yellow-500' : 'text-muted-foreground/30'}`} aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>)}</div>
								<blockquote class="mb-8 text-center font-serif text-xl leading-relaxed md:text-2xl">“{voice.story}”</blockquote>
								<div class="space-y-2 text-center">
									<div class="text-lg">{voice.name}</div>
									{voice.location && <div class="font-light text-muted-foreground">{voice.location}</div>}
									{voice.work && <div class="flex items-center justify-center gap-2 text-sm text-muted-foreground"><span class="rounded-full bg-secondary px-3 py-1">{voice.work}</span></div>}
								</div>
							</div>
						))}
					</div>
				</div>
				<div class="mt-8 flex justify-center gap-2">
					{testimonials.map((voice, index) => (
						<button type="button" data-voice-dot aria-label={`Go to testimonial ${index + 1}`} class={`h-3 w-3 rounded-full transition-all duration-300 ${index === 0 ? 'scale-125 bg-foreground' : 'bg-muted-foreground/30 hover:bg-muted-foreground/60'}`}></button>
					))}
				</div>
			</div>
			<div class="mt-16 grid gap-6 md:grid-cols-3">
				{testimonials.slice(0, 3).map((voice, index) => (
					<button type="button" data-voice-jump={index} class="cursor-pointer rounded-lg border border-border bg-surface p-6 text-left transition-all duration-300 hover:scale-105 hover:shadow-lg">
						<div class="mb-3 flex" aria-label={`${voice.rating} out of 5 stars`}>{[1, 2, 3, 4, 5].map((n) => <svg viewBox="0 0 24 24" fill="currentColor" class={`h-4 w-4 ${n <= voice.rating ? 'text-yellow-500' : 'text-muted-foreground/30'}`} aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>)}</div>
						<p class="mb-4 leading-relaxed text-foreground/80">“{voice.story.substring(0, 120)}...”</p>
						<div class="text-sm"><div>{voice.name}</div><div class="font-light text-muted-foreground">{voice.location}</div></div>
					</button>
				))}
			</div>
			</Fragment>
			)}
			<div class="mt-16 text-center">
				<div class="inline-block rounded-lg bg-gradient-to-r from-secondary/20 to-accent-soft/20 p-6">
					<svg viewBox="0 0 24 24" fill="currentColor" class="mx-auto mb-4 h-8 w-8 animate-pulse text-red-500" role="img" aria-label="With love"><path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" /></svg>
					<h3 class="mb-2 font-serif text-xl">Share Your Voice</h3>
					<p class="max-w-md font-light text-muted-foreground">Have you been touched by these words? Your story matters, and we'd love to hear how these books have become part of your journey.</p>
					<a
						href="#contact"
						data-share-voice
						class="mt-5 inline-flex items-center gap-2 rounded-full bg-foreground px-6 py-3 text-sm text-background transition-transform duration-300 hover:scale-105"
					>
						<Icon name="lucide:message-circle" class="h-4 w-4" aria-hidden="true" />
						Share your story
					</a>
				</div>
			</div>
		</section>

		<section id="contact" class="border-t border-border py-16 scroll-mt-24">
			<div class="text-center">
				<div class="mb-6 flex items-center justify-center gap-3 text-muted-foreground" aria-hidden="true"><span class="h-px w-16 bg-current/40"></span><Icon name="lucide:mail" class="h-5 w-5 animate-pulse" /><span class="h-px w-16 bg-current/40"></span></div>
				<h2 class="font-serif text-4xl md:text-5xl">Connect</h2>
				<p class="mx-auto mt-4 max-w-2xl font-light tracking-wide text-muted-foreground">
					For literary inquiries, collaboration opportunities, or simply to share how these words have touched your soul.
				</p>
			</div>
			<div class="mt-12 grid grid-cols-1 gap-12 text-left lg:grid-cols-2">
				<div class="space-y-8">
					<div>
						<h3 class="mb-6 font-serif text-2xl">Let's Connect</h3>
						<p class="mb-8 leading-relaxed text-foreground/80">Every message is read with care and intention. Whether you're a fellow writer seeking guidance, a reader whose heart has been moved, or someone with a story to share, your words are welcome here.</p>
					</div>
					<div class="space-y-6">
						<div class="flex items-start gap-4">
							<div class="rounded-full bg-secondary p-3"><Icon name="lucide:mail" class="h-5 w-5" aria-hidden="true" /></div>
							<div><h4 class="mb-1">Email</h4><p class="font-light text-muted-foreground">stezora97@lunarshells.com</p></div>
						</div>
						<div class="flex items-start gap-4">
							<div class="rounded-full bg-secondary p-3"><Icon name="lucide:map-pin" class="h-5 w-5" aria-hidden="true" /></div>
							<div><h4 class="mb-1">Location</h4><p class="font-light text-muted-foreground">Melbourne, Australia</p></div>
						</div>
						<div class="flex items-start gap-4">
							<div class="rounded-full bg-secondary p-3"><Icon name="lucide:clock-3" class="h-5 w-5" aria-hidden="true" /></div>
							<div><h4 class="mb-1">Response Time</h4><p class="font-light text-muted-foreground">Within 48 hours</p></div>
						</div>
					</div>
					<div class="rounded-r-lg border-l-4 border-border bg-surface/50 py-4 pl-6">
						<blockquote class="mb-2 font-serif italic text-foreground/80">"Words are bridges between souls. Let us build one together."</blockquote>
						<cite class="text-sm text-muted-foreground">&mdash; Stezora</cite>
					</div>
				</div>
				<div class="rounded-lg border border-border bg-surface p-8">
					<div class="mb-6 flex items-center gap-3"><Icon name="lucide:message-circle" class="h-6 w-6 text-muted-foreground" aria-hidden="true" /><h3 class="font-serif text-xl">Send a Message</h3></div>
					<form class="space-y-6" action="mailto:stezora97@lunarshells.com" method="post" enctype="text/plain">
						<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
							<div>
								<label for="contact-name" class="mb-2 block text-sm">Name</label>
								<input type="text" id="contact-name" name="name" required class={contactControl} />
							</div>
							<div>
								<label for="contact-email" class="mb-2 block text-sm">Email</label>
								<input type="email" id="contact-email" name="email" required class={contactControl} />
							</div>
						</div>
						<div>
							<label for="contact-subject" class="mb-2 block text-sm">Subject</label>
							<select id="contact-subject" name="subject" required class={contactControl}>
								<option value="">Select a subject</option>
								<option value="general">General Inquiry</option>
								<option value="collaboration">Collaboration</option>
								<option value="press">Press/Media</option>
								<option value="reader">Reader Feedback</option>
							<option value="testimonials">Testimonials</option>
								<option value="writing">Writing Question</option>
							</select>
						</div>
						<div>
							<label for="contact-message" class="mb-2 block text-sm">Message</label>
							<textarea id="contact-message" name="message" rows="6" required placeholder="Share your thoughts, questions, or stories..." class={`${contactControl} resize-none`}></textarea>
						</div>
						<button type="submit" class="group flex w-full items-center justify-center gap-2 rounded-lg bg-foreground px-6 py-3 text-background transition-all duration-300 hover:bg-foreground/90">
							<span>Send Message</span>
							<Icon name="lucide:send" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
						</button>
					</form>
				</div>
			</div>
		</section>
	</Container>
	<footer class="px-6 pb-16 pt-4 text-center">
		<div class="inline-block max-w-md rounded-lg border border-border bg-surface/50 p-6">
			{/* Inline solid heart: the lucide sprite pins fill="none", so CSS cannot fill it. */}
			<svg viewBox="0 0 24 24" fill="currentColor" class="mx-auto mb-3 h-6 w-6 animate-pulse text-red-500" role="img" aria-label="With love">
				<path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" />
			</svg>
		<p class="text-sm font-light text-muted-foreground">To the ones who have felt everything too deeply, who held their breath through pain and kept walking, who questioned everything and still chose love — this is for you.</p>
		</div>
	</footer>
	<script>
		// Share Your Voice: jump to the contact form with the subject preselected.
		document.querySelector('[data-share-voice]')?.addEventListener('click', () => {
			const subject = document.getElementById('contact-subject');
			if (subject instanceof HTMLSelectElement) {
				subject.value = 'testimonials';
			}
		});

		// Reader Voices carousel: auto-advances every 6s; any manual action stops it.
		const slides = Array.from(document.querySelectorAll('[data-voice-slide]'));
		const dots = Array.from(document.querySelectorAll('[data-voice-dot]'));
		if (slides.length > 0) {
			let index = 0;
			const show = (next: number) => {
				index = (next + slides.length) % slides.length;
				slides.forEach((slide, i) => slide.classList.toggle('hidden', i !== index));
				dots.forEach((dot, i) => {
					dot.classList.toggle('bg-foreground', i === index);
					dot.classList.toggle('scale-125', i === index);
					dot.classList.toggle('bg-muted-foreground/30', i !== index);
					dot.classList.toggle('hover:bg-muted-foreground/60', i !== index);
				});
			};
			const timer = setInterval(() => show(index + 1), 6000);
			const manual = (next: number) => {
				clearInterval(timer);
				show(next);
			};
			document.querySelector('[data-voice-prev]')?.addEventListener('click', () => manual(index - 1));
			document.querySelector('[data-voice-next]')?.addEventListener('click', () => manual(index + 1));
			dots.forEach((dot, i) => dot.addEventListener('click', () => manual(i)));
			document.querySelectorAll<HTMLElement>('[data-voice-jump]').forEach((card) => {
				card.addEventListener('click', () => manual(Number(card.dataset.voiceJump)));
			});
		}
	</script>
</BaseLayout>
