---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist." path="/404" noindex>
	<Container class="flex flex-col items-center py-24 text-center">
		<p class="font-serif text-6xl font-bold">404</p>
		<h1 class="mt-4 font-serif text-2xl font-semibold">Page not found</h1>
		<p class="mt-2 text-muted-foreground">The page you are looking for does not exist or has moved.</p>
		<Button href="/" variant="primary" class="mt-8">Back to home</Button>
	</Container>
</BaseLayout>
