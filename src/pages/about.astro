---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { SITE } from '../lib/seo/config';
---

<BaseLayout title="About" description={`About ${SITE.name}`} path="/about">
	<Container class="py-16">
		<article class="max-w-2xl space-y-4 text-foreground">
			<h1 class="font-serif text-3xl font-bold tracking-tight sm:text-4xl">About</h1>
			<p>
				{SITE.name} is a personal multi-publication publishing platform. It hosts three
				publications under one roof, written by one author.
			</p>
			<p>
				This site is part of an ongoing effort to move away from Blogger while preserving the
				content, history, and readership of three existing blogs.
			</p>
			<p>
				Three publications are live, each with its own categories, tags, and articles — all
				served from a single Astro build.
			</p>
		</article>
	</Container>
</BaseLayout>
