---
import PublicationLayout from '../../../../layouts/PublicationLayout.astro';
import { getTagsForPublication } from '../../../../lib/publications/collections';
import { getPublications, publicationPath, tagPath } from '../../../../lib/publications';

export function getStaticPaths() {
	return getPublications().map((publication) => ({
		params: { slug: publication.slug },
		props: { publication },
	}));
}

const { slug } = Astro.params;
const { publication } = Astro.props;

const tags = await getTagsForPublication(slug);
---

<PublicationLayout
	publication={publication}
	title="Tags"
	description={`Tags in ${publication.name}.`}
	path={`${publicationPath(publication.slug)}/tags`}
>
	<section>
		<h2 class="font-serif text-2xl font-semibold">Tags</h2>
		<ul class="mt-6 flex flex-wrap gap-2">
			{tags.map((tag) => (
				<li>
					<a
						href={tagPath(publication.slug, tag.slug)}
						class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-sm text-slate-600 transition-colors hover:border-slate-400 hover:text-slate-900 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-white"
					>
						#{tag.name}
						<span class="text-xs text-slate-400 dark:text-slate-500">{tag.count}</span>
					</a>
				</li>
			))}
		</ul>
	</section>
</PublicationLayout>
