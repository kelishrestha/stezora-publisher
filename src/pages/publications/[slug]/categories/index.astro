---
import PublicationLayout from '../../../../layouts/PublicationLayout.astro';
import { getCategoriesForPublication } from '../../../../lib/publications/collections';
import { categoryPath, getPublications, publicationPath } from '../../../../lib/publications';

export function getStaticPaths() {
	return getPublications().map((publication) => ({
		params: { slug: publication.slug },
		props: { publication },
	}));
}

const { slug } = Astro.params;
const { publication } = Astro.props;

const categories = await getCategoriesForPublication(slug);
---

<PublicationLayout
	publication={publication}
	title="Categories"
	description={`Categories in ${publication.name}.`}
	path={`${publicationPath(publication.slug)}/categories`}
>
	<section>
		<h2 class="font-serif text-2xl font-semibold">Categories</h2>
		<ul class="mt-6 grid gap-4 sm:grid-cols-2">
			{categories.map((category) => (
				<li>
					<a
						href={categoryPath(publication.slug, category.slug)}
						class="flex items-center justify-between rounded-xl border border-border bg-surface px-5 py-4 transition-colors hover:border-accent"
					>
						<span class="font-medium">{category.name}</span>
						<span class="text-sm text-muted-foreground">{category.count}</span>
					</a>
				</li>
			))}
		</ul>
	</section>
</PublicationLayout>
