---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookShelf from '../../components/publication/BookShelf';

const books = [
	{
		id: 'the-warrior-must-rise',
		title: 'The Warrior Must Rise',
		author: 'Stezora',
		year: '2025',
		meta: 'Self-help · 56 pages · $18.99',
		stars: 5,
		desc: 'A Short Story of a Warrior. The journey of a warrior from cold ashes to rising phoenix.',
		cover: '/the-warrior-must-rise-cover.png',
		href: '/poetry-collections/the-rebellious-flame',
		cta: 'Explore The Rebellious Flame',
	},
	{
		id: 'the-peach-fall',
		title: 'The Peach Fall',
		author: 'Stezora',
		year: '2024',
		meta: 'Self-help · 56 pages · $14.99',
		stars: 5,
		desc: 'A Story of a Girl. The inside journey of a girl who struggles to live by her own. Dedicated to all the people suffering from loneliness and depression.',
		cover: '/the-peach-fall-cover.jpg',
		href: '/poetry-collections/the-sore-transition',
		cta: 'Explore The Sore Transition',
	},
];
---

<BaseLayout title="Books" description="Published books by Stezora." path="/publications">
	<div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
		<header>
			<p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">All Books</p>
			<h1 class="mt-2 font-serif text-3xl font-bold tracking-tight sm:text-4xl">Published books</h1>
			<p class="mt-3 max-w-2xl text-muted-foreground">
				Stories that left the notebook. Pick a book from the shelf to learn more.
			</p>
		</header>
		<div class="mt-10">
			<BookShelf
				client:load
				books={books}
				hint="Pick a book from the shelf to see where its story continues."
			/>
		</div>
	</div>
</BaseLayout>
