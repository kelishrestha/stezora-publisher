---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/publication/PublicationCard.astro';
import { PUBLICATIONS_PATH, getPublications } from '../../lib/publications';

const publications = getPublications();
---

<BaseLayout title="Publications" description="All publications on this site." path={PUBLICATIONS_PATH}>
	<div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
		<header>
			<p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">Publications</p>
			<h1 class="mt-2 font-serif text-3xl font-bold tracking-tight sm:text-4xl">Browse publications</h1>
			<p class="mt-3 max-w-2xl text-muted-foreground">
				Three distinct voices, one shared home. Choose a publication to read its latest writing.
			</p>
		</header>
		<div class="mt-10 grid gap-6 sm:grid-cols-3">
			{publications.map((publication) => (
				<PublicationCard publication={publication} />
			))}
		</div>
	</div>
</BaseLayout>
