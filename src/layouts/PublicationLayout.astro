---
import BaseLayout from './BaseLayout.astro';
import PublicationHeader from '../components/publication/PublicationHeader.astro';
import type { Publication } from '../lib/publications/types';
import type { BreadcrumbItem } from '../lib/seo/structured-data';
import { absoluteUrl } from '../lib/seo/seo';
import { getCategoriesForPublication, getTagsForPublication } from '../lib/publications/collections';
import { PUBLICATIONS_PATH, publicationPath, publicationRssPath } from '../lib/publications';

export interface Props {
	publication: Publication;
	title?: string;
	description?: string;
	path: string;
	breadcrumbs?: BreadcrumbItem[];
}

const { publication, title, description, path, breadcrumbs = [] } = Astro.props;

const categories = await getCategoriesForPublication(publication.slug);
const tags = await getTagsForPublication(publication.slug);

const pageTitle = title ?? `${publication.name} — ${publication.description}`;
const trail = breadcrumbs.length > 0
	? breadcrumbs
	: [
		{ name: 'Home', href: '/' },
		{ name: 'Publications', href: PUBLICATIONS_PATH },
		{ name: publication.name, href: publicationPath(publication.slug) },
	];
---

<BaseLayout
	title={pageTitle}
	description={description ?? publication.description}
	path={path}
	breadcrumbs={trail}
>
	<link
		slot="head"
		rel="alternate"
		type="application/rss+xml"
		title={`${publication.name} RSS Feed`}
		href={absoluteUrl(publicationRssPath(publication.slug))}
	/>
	<PublicationHeader publication={publication} categories={categories} tags={tags} />
	<div class="mx-auto w-full max-w-4xl flex-1 px-4 py-10 sm:px-6">
		<slot />
	</div>
</BaseLayout>
