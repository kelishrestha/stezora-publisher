---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/blog/Breadcrumbs.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import ConfirmDialog from '../components/ui/ConfirmDialog.astro';

interface Crumb {
	name: string;
	href?: string;
}

interface Props {
	title?: string;
	description?: string;
	path?: string;
	breadcrumbs?: Crumb[];
}

const { title, description, path = '/admin', breadcrumbs = [] } = Astro.props;

const navItems = [
	{ href: '/admin', label: 'Dashboard', icon: 'lucide:layout-dashboard' },
	{ href: '/admin/analytics', label: 'Analytics', icon: 'lucide:chart-column' },
	{ href: '/admin/audience', label: 'Audience', icon: 'lucide:users' },
	{ href: '/admin/posts', label: 'Posts', icon: 'lucide:file-text' },
	{ href: '/admin/books', label: 'Books', icon: 'lucide:book-open' },
	{ href: '/admin/testimonials', label: 'Testimonials', icon: 'lucide:quote' },
	{ href: '/admin/media', label: 'Media', icon: 'lucide:image' },
	{ href: '/admin/tags', label: 'Tags', icon: 'lucide:tags' },
];

// Settings is a collapsible group with its integration sub-items.
const settingsChildren = [
	{ href: '/admin/settings/integrations#blogger', label: 'Blogger integration' },
	{ href: '/admin/settings/integrations#neobook', label: 'Neobook integration' },
	{ href: '/admin/settings/integrations#automation', label: 'Automation' },
];
const settingsExpanded = path.startsWith('/admin/settings');

function isActive(href: string): boolean {
	return href === '/admin' ? path === '/admin' : path.startsWith(href);
}

const activeLink = 'flex items-center gap-2 rounded-lg bg-accent-soft px-4 py-2 text-sm font-medium text-accent-foreground';
const inactiveLink =
	'flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent-soft hover:text-accent-foreground';
---

<BaseLayout title={title} description={description} path={path} noindex chrome={false} accent="admin">
	<!-- Top bar: logo only, with the theme toggle (HyperUI header on theme tokens). -->
	<header class="sticky top-0 z-20 border-b border-border bg-background/90 backdrop-blur">
		<div class="flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
			<a href="/admin" class="block" aria-label="Stezora CMS">
				<span class="sr-only">Stezora CMS</span>
				<span class="relative inline-block h-8 w-8 align-middle">
					<img src="/stezora-logo-light.png" alt="Stezora" class="absolute inset-0 h-8 w-8 object-contain dark:hidden" />
					<img src="/stezora-logo-dark.png" alt="" class="absolute inset-0 hidden h-8 w-8 object-contain dark:block" />
				</span>
			</a>
			<ThemeToggle />
		</div>
	</header>

	<div class="flex flex-1">
		<!-- HyperUI side menu on theme tokens: nav on top, sign out pinned at the bottom. -->
		<aside class="sticky top-16 hidden h-[calc(100vh-4rem)] w-64 shrink-0 flex-col justify-between border-e border-border bg-surface sm:flex lg:w-72">
			<div class="p-4">
				<ul class="space-y-1">
					{navItems.map((item) => (
						<li>
							<a href={item.href} class={isActive(item.href) ? activeLink : inactiveLink}>
								<Icon name={item.icon} class="size-4 shrink-0" aria-hidden="true" />
								{item.label}
							</a>
						</li>
					))}
					<li>
						<div class={`${isActive('/admin/settings') ? activeLink : inactiveLink} justify-between pr-2`}>
							<a href="/admin/settings" class="flex min-w-0 flex-1 items-center gap-2">
								<Icon name="lucide:settings" class="size-4 shrink-0" aria-hidden="true" />
								Settings
							</a>
							<button
								type="button"
								id="settings-toggle"
								aria-expanded={settingsExpanded}
								aria-controls="settings-submenu"
								aria-label="Toggle settings sub-items"
								class="rounded p-1 text-current transition-colors hover:bg-accent-soft/60"
							>
								<Icon id="settings-chevron" name="lucide:chevron-down" class={`size-4 shrink-0 transition-transform ${settingsExpanded ? 'rotate-180' : ''}`} aria-hidden="true" />
							</button>
						</div>
						<ul id="settings-submenu" class="ms-5 mt-1 space-y-1 border-s border-border ps-3" hidden={!settingsExpanded}>
							{settingsChildren.map((child) => (
								<li>
									<a
										href={child.href}
										class="block rounded-lg px-3 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-accent-soft hover:text-accent-foreground"
									>
										{child.label}
									</a>
								</li>
							))}
						</ul>
					</li>
					<li>
						<a href="/" target="_blank" rel="noopener" class={inactiveLink}>
							<Icon name="lucide:external-link" class="size-4 shrink-0" aria-hidden="true" />
							View site
						</a>
					</li>
				</ul>
			</div>
			<div class="sticky inset-x-0 bottom-0 border-t border-border bg-surface p-4">
				<button
					type="button"
					id="admin-sign-out"
					class="flex w-full items-center gap-2 rounded-lg px-4 py-2 text-left text-sm font-medium text-muted-foreground transition-colors hover:bg-accent-soft hover:text-accent-foreground"
				>
					<Icon name="lucide:log-out" class="size-4 shrink-0" aria-hidden="true" />
					Sign out
				</button>
				<div class="mt-3 flex items-center gap-2 border-t border-border px-1 pt-3">
					<span
						id="admin-user-initial"
						class="grid size-8 shrink-0 place-content-center rounded-full bg-accent-soft text-xs font-semibold text-accent-foreground"
						aria-hidden="true"
					></span>
					<div class="min-w-0">
						<p id="admin-user-name" class="truncate text-sm font-medium text-foreground">&nbsp;</p>
						<p id="admin-user-email" class="truncate text-xs text-muted-foreground"></p>
					</div>
				</div>
			</div>
		</aside>

		<main class="min-w-0 flex-1 px-4 py-8 sm:px-6 lg:px-8">
			<!-- Content takes 75% of the pane on large screens (left aligned); full width below. -->
			<div class="w-full lg:w-3/4">
			<!-- Small screens get the same navigation as a scrollable strip. -->
			<nav aria-label="Admin" class="mb-6 flex gap-1 overflow-x-auto border-b border-border pb-3 text-sm sm:hidden">
				{navItems.map((item) => (
					<a
						href={item.href}
						class={`shrink-0 rounded-lg px-3 py-1.5 ${
							isActive(item.href)
								? 'bg-accent-soft font-medium text-accent-foreground'
								: 'text-muted-foreground hover:bg-accent-soft hover:text-accent-foreground'
						}`}
					>
						{item.label}
					</a>
				))}
				<a
					href="/admin/settings"
					class={`shrink-0 rounded-lg px-3 py-1.5 ${
						isActive('/admin/settings')
							? 'bg-accent-soft font-medium text-accent-foreground'
							: 'text-muted-foreground hover:bg-accent-soft hover:text-accent-foreground'
					}`}
				>
					Settings
				</a>
				<a href="/" target="_blank" rel="noopener" class="shrink-0 rounded-lg px-3 py-1.5 text-muted-foreground hover:bg-surface-elevated hover:text-foreground">
					View site
				</a>
				<button
					type="button"
					id="admin-sign-out-mobile"
					class="shrink-0 rounded-lg px-3 py-1.5 text-muted-foreground hover:bg-surface-elevated hover:text-foreground"
				>
					Sign out
				</button>
			</nav>
			{breadcrumbs.length > 0 && (
				<div class="mb-6">
					<Breadcrumbs items={breadcrumbs} />
				</div>
			)}
			<slot />
			</div>
		</main>
	</div>
	<ConfirmDialog id="signout-modal" title="Sign out?" message="You will be returned to the sign-in page." confirmLabel="Sign out" tone="danger" />
</BaseLayout>

<script>
	import { createAuthClient } from 'better-auth/client';

	const authClient = createAuthClient();

	const signoutModal = document.getElementById('signout-modal');
	const openSignout = () => signoutModal?.removeAttribute('hidden');

	async function signOut() {
		await authClient.signOut();
		window.location.href = '/admin/login';
	}

	document.getElementById('admin-sign-out')?.addEventListener('click', openSignout);
	document.getElementById('admin-sign-out-mobile')?.addEventListener('click', openSignout);
	signoutModal?.addEventListener('confirm', () => void signOut());

	// Collapsible Settings sub-items.
	const settingsToggle = document.getElementById('settings-toggle');
	const settingsSubmenu = document.getElementById('settings-submenu');
	const settingsChevron = document.getElementById('settings-chevron');
	settingsToggle?.addEventListener('click', () => {
		const expanded = settingsToggle.getAttribute('aria-expanded') === 'true';
		settingsToggle.setAttribute('aria-expanded', String(!expanded));
		settingsSubmenu?.toggleAttribute('hidden', expanded);
		settingsChevron?.classList.toggle('rotate-180', !expanded);
	});

	// Show the signed-in user above the sign-out button.
	void authClient.getSession().then((result) => {
		const user = result?.data?.user;
		if (!user) return;
		const name = user.name || user.email || '';
		const nameEl = document.getElementById('admin-user-name');
		const emailEl = document.getElementById('admin-user-email');
		const initialEl = document.getElementById('admin-user-initial');
		if (nameEl) nameEl.textContent = name;
		if (emailEl && user.email && user.email !== name) emailEl.textContent = user.email;
		if (initialEl) initialEl.textContent = (name.trim().charAt(0) || '?').toUpperCase();
	});
</script>
