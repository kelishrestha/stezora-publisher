---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/blog/Breadcrumbs.astro';
import PostMeta from '../components/blog/PostMeta.astro';
import type { Post } from '../lib/publications/collections';
import type { Publication } from '../lib/publications/types';
import { PUBLICATIONS_PATH, publicationPath, postExcerpt, postPath, slugify, tagPath } from '../lib/publications';
import { badgeClass } from '../components/ui/shared/classes';

export interface Props {
	post: Post;
	publication: Publication;
}

const { post, publication } = Astro.props;

// The content id is publication-prefixed; the view API keys posts by the bare
// slug (matching posts.slug in D1), so strip the prefix for the badge lookup.
const postSlug = post.id.startsWith(`${publication.slug}-`)
	? post.id.slice(publication.slug.length + 1)
	: post.id;

const path = postPath(publication.slug, post.id);

// The app centralizes a post's reach, so views are a single total (first-party
// plus Neobook, summed client-side) rather than two separate counts. Likes and
// comments come from Neobook; each stat is shown only when positive.
const neobookViews = post.data.neobookViews ?? 0;
const engagementParts = [
	post.data.neobookLikes ? `${post.data.neobookLikes.toLocaleString()} likes` : null,
	post.data.neobookComments ? `${post.data.neobookComments.toLocaleString()} comments` : null,
].filter((part): part is string => part !== null);
const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Poetry Collections', href: PUBLICATIONS_PATH },
	{ name: publication.name, href: publicationPath(publication.slug) },
	{ name: post.data.title },
];
---

<BaseLayout
	title={post.data.title}
	description={post.data.seoDescription ?? postExcerpt(post.data)}
	seoTitle={post.data.seoTitle}
	path={path}
	type="article"
	publishedAt={post.data.pubDate}
	updatedAt={post.data.updatedDate}
	breadcrumbs={breadcrumbs}
	accent={publication.accent}
>
	<article class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
		<header>
			<Breadcrumbs items={breadcrumbs} />
			<h1 class="mt-6 font-serif text-3xl font-bold tracking-tight sm:text-4xl">{post.data.title}</h1>
			<div class="mt-4">
				<PostMeta pubDate={post.data.pubDate} updatedDate={post.data.updatedDate} />
			</div>
			<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground">
				<span data-view-badge hidden class="inline-flex items-center gap-1.5">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
						<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
						<circle cx="12" cy="12" r="3" />
					</svg>
					<span data-view-count data-publication={publication.slug} data-post={postSlug} data-neobook-views={neobookViews}></span>
					<span>views</span>
				</span>
				{engagementParts.length > 0 && <span>{engagementParts.join(' · ')}</span>}
				{post.data.neobookUrl && (
					<a href={post.data.neobookUrl} target="_blank" rel="noopener" class="text-accent-foreground hover:underline">View on Neobook</a>
				)}
			</div>
		</header>
		<div class="prose mt-10 max-w-none dark:prose-invert">
			<slot />
		</div>
		{post.data.tags.length > 0 && (
			<footer class="clear-both mt-16">
				<div class="flex flex-wrap items-center gap-2">
					{post.data.tags.map((tag) => (
						<a
							href={tagPath(publication.slug, slugify(tag))}
							class={`${badgeClass('solid')} transition-opacity hover:opacity-80`}
						>
							#{tag}
						</a>
					))}
				</div>
			</footer>
		)}
	</article>
</BaseLayout>

<script>
	// First-party view count for the on-page badge (reads our own /api/views).
	// The badge stays hidden unless the post has a positive view count.
	const el = document.querySelector('[data-view-count]');
	const badge = document.querySelector('[data-view-badge]');
	if (el instanceof HTMLElement && el.dataset.publication && el.dataset.post) {
		// Total views centralize this app's first-party count with the Neobook
		// count (baked into the page). Shown only when the sum is positive.
		const neobookViews = Number(el.dataset.neobookViews || '0');
		const show = (total: number) => {
			if (total > 0) {
				el.textContent = new Intl.NumberFormat().format(total);
				badge?.removeAttribute('hidden');
			}
		};
		fetch(`/api/views/${encodeURIComponent(el.dataset.publication)}/${encodeURIComponent(el.dataset.post)}`)
			.then((response) => (response.ok ? (response.json() as Promise<{ views?: number }>) : null))
			.then((data) => {
				const firstParty = data && typeof data.views === 'number' ? data.views : 0;
				show(firstParty + neobookViews);
			})
			.catch(() => show(neobookViews));
	}
</script>
