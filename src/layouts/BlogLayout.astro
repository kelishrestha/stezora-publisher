---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/blog/Breadcrumbs.astro';
import PostMeta from '../components/blog/PostMeta.astro';
import type { Post } from '../lib/publications/collections';
import type { Publication } from '../lib/publications/types';
import { PUBLICATIONS_PATH, publicationPath, postExcerpt, postPath, slugify, tagPath } from '../lib/publications';
import { badgeClass } from '../components/ui/shared/classes';

export interface Props {
	post: Post;
	publication: Publication;
}

const { post, publication } = Astro.props;

const path = postPath(publication.slug, post.id);
const breadcrumbs = [
	{ name: 'Home', href: '/' },
	{ name: 'Poetry Collections', href: PUBLICATIONS_PATH },
	{ name: publication.name, href: publicationPath(publication.slug) },
	{ name: post.data.title },
];
---

<BaseLayout
	title={post.data.title}
	description={post.data.seoDescription ?? postExcerpt(post.data)}
	seoTitle={post.data.seoTitle}
	path={path}
	type="article"
	publishedAt={post.data.pubDate}
	updatedAt={post.data.updatedDate}
	breadcrumbs={breadcrumbs}
	accent={publication.accent}
>
	<article class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
		<header>
			<Breadcrumbs items={breadcrumbs} />
			<h1 class="mt-6 font-serif text-3xl font-bold tracking-tight sm:text-4xl">{post.data.title}</h1>
			<div class="mt-4">
				<PostMeta pubDate={post.data.pubDate} updatedDate={post.data.updatedDate} />
			</div>
		</header>
		{/* Snug body width: the floated featured image sits right against the
		    text instead of drifting to the far edge of the wide article. */}
		<div class="prose mt-10 max-w-3xl dark:prose-invert">
			<slot />
		</div>
		{post.data.tags.length > 0 && (
			<footer class="clear-both mt-16">
				<div class="flex flex-wrap items-center gap-2">
					{post.data.tags.map((tag) => (
						<a
							href={tagPath(publication.slug, slugify(tag))}
							class={`${badgeClass('solid')} transition-opacity hover:opacity-80`}
						>
							#{tag}
						</a>
					))}
				</div>
			</footer>
		)}
	</article>
</BaseLayout>
