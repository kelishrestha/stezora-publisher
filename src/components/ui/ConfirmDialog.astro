---
/**
 * Reusable confirmation dialog for Astro/layout contexts (the React admin
 * islands use the `ConfirmDialog` component / `useConfirm` hook instead).
 *
 * Render it with a unique `id`, then from your own script:
 *   const modal = document.getElementById('my-id');
 *   openButton.addEventListener('click', () => modal.removeAttribute('hidden'));
 *   modal.addEventListener('confirm', () => doTheThing());
 *
 * Cancel, the Escape key, and clicking the backdrop all close it; clicking the
 * confirm button dispatches a `confirm` event and closes it.
 */
import { buttonClass, modalOverlayClass, modalPanelClass } from './shared/classes';

interface Props {
	id: string;
	title: string;
	message: string;
	confirmLabel?: string;
	tone?: 'danger' | 'primary';
}

const { id, title, message, confirmLabel = 'Confirm', tone = 'danger' } = Astro.props;
---

<div id={id} data-confirm-dialog hidden class={modalOverlayClass} role="dialog" aria-modal="true" aria-labelledby={`${id}-title`}>
	<div class={modalPanelClass()}>
		<h2 id={`${id}-title`} class="text-base font-semibold text-foreground">{title}</h2>
		<p class="mt-2 text-sm text-muted-foreground">{message}</p>
		<div class="mt-5 flex justify-end gap-2">
			<button type="button" data-confirm-cancel class={buttonClass('outline')}>Cancel</button>
			<button type="button" data-confirm-ok class={buttonClass(tone === 'primary' ? 'primary' : 'danger')}>{confirmLabel}</button>
		</div>
	</div>
</div>

<script>
	// Wire every confirm dialog on the page (this module is bundled once).
	const dialogs = document.querySelectorAll<HTMLElement>('[data-confirm-dialog]');
	for (const modal of dialogs) {
		const close = () => modal.setAttribute('hidden', '');
		modal.querySelector('[data-confirm-cancel]')?.addEventListener('click', close);
		modal.addEventListener('click', (event) => {
			if (event.target === modal) close();
		});
		modal.querySelector('[data-confirm-ok]')?.addEventListener('click', () => {
			modal.dispatchEvent(new CustomEvent('confirm'));
			close();
		});
	}
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		document.querySelectorAll<HTMLElement>('[data-confirm-dialog]:not([hidden])').forEach((modal) => modal.setAttribute('hidden', ''));
	});
</script>
