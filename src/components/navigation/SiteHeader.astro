---
import ThemeToggle from '../ui/ThemeToggle.astro';
import Container from '../ui/Container.astro';
import { SITE } from '../../lib/seo/config';
import { PUBLICATIONS_PATH } from '../../lib/publications';

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: PUBLICATIONS_PATH, label: 'Publications' },
	{ href: '/about', label: 'About' },
];
---

<header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/90">
	<Container class="flex items-center justify-between py-4">
		<a href="/" class="font-serif text-lg font-semibold tracking-tight" aria-label={`${SITE.name} home`}>
			{SITE.name}
		</a>
		<nav aria-label="Main">
			<ul class="flex items-center gap-6">
				{navLinks.map((link) => (
					<li>
						<a href={link.href} class="text-sm font-medium text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">
							{link.label}
						</a>
					</li>
				))}
				<li>
					<ThemeToggle />
				</li>
			</ul>
		</nav>
	</Container>
</header>
