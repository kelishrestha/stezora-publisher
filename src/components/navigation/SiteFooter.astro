---
import Container from '../ui/Container.astro';
import { SITE } from '../../lib/seo/config';
---

<!-- HyperUI footer pattern (rows above a bordered copyright line) on theme tokens. -->
<footer class="border-t border-border bg-background">
	<Container class="space-y-8 py-12">
		<div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
			<p class="font-serif text-base font-medium text-foreground">In every ending, a new story begins.</p>
			<p class="text-sm text-muted-foreground">
				Published with <a href="https://astro.build" class="transition hover:opacity-75">Astro</a>, hosted on
				Cloudflare.
			</p>
		</div>
		<p class="border-t border-border pt-8 text-xs text-muted-foreground">
			&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.
		</p>
	</Container>
</footer>
