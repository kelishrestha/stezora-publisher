---
import type { Publication } from '../../lib/publications/types';

interface Props {
	publication: Publication;
}

const { publication } = Astro.props;
---

<header class="py-10">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
		<p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">Publication</p>
		<h1 class="mt-2 font-serif text-3xl font-bold tracking-tight sm:text-4xl">{publication.name}</h1>
		<p class="mt-3 max-w-2xl text-base text-muted-foreground">{publication.description}</p>
	</div>
</header>
