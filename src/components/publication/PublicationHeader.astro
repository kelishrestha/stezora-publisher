---
import type { Publication } from '../../lib/publications/types';
import type { TermCount } from '../../lib/publications/collections';
import { categoryPath, publicationPath, publicationRssPath, tagPath } from '../../lib/publications';

interface Props {
	publication: Publication;
	categories: TermCount[];
	tags: TermCount[];
}

const { publication, categories, tags } = Astro.props;

const links = [
	{ href: publicationPath(publication.slug), label: 'Articles' },
	{ href: `${publicationPath(publication.slug)}/categories`, label: 'Categories' },
	{ href: `${publicationPath(publication.slug)}/tags`, label: 'Tags' },
	{ href: publicationRssPath(publication.slug), label: 'RSS' },
];
---

<header class="border-b border-slate-200 py-10 dark:border-slate-800">
	<div class="mx-auto w-full max-w-4xl px-4 sm:px-6">
		<p class="text-xs font-medium uppercase tracking-widest text-slate-400 dark:text-slate-500">Publication</p>
		<h1 class="mt-2 font-serif text-3xl font-bold tracking-tight sm:text-4xl">{publication.name}</h1>
		<p class="mt-3 max-w-2xl text-base text-slate-600 dark:text-slate-300">{publication.description}</p>

		<nav aria-label={`${publication.name} navigation`} class="mt-6">
			<ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium">
				{links.map((link) => (
					<li>
						<a
							href={link.href}
							class="text-slate-700 transition-colors hover:text-slate-900 dark:text-slate-200 dark:hover:text-white"
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		{categories.length > 0 && (
			<div class="mt-5 flex flex-wrap gap-2">
				{categories.map((category) => (
					<a
						href={categoryPath(publication.slug, category.slug)}
						class="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-600 transition-colors hover:border-slate-400 hover:text-slate-900 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-white"
					>
						{category.name}
					</a>
				))}
			</div>
		)}

		{tags.length > 0 && (
			<div class="mt-2 flex flex-wrap gap-2">
				{tags.map((tag) => (
					<a
						href={tagPath(publication.slug, tag.slug)}
						class="text-xs text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
					>
						#{tag.name}
					</a>
				))}
			</div>
		)}
	</div>
</header>
