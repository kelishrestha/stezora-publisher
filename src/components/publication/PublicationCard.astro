---
import type { Publication } from '../../lib/publications/types';
import { publicationPath } from '../../lib/publications';

interface Props {
	publication: Publication;
}

const { publication } = Astro.props;
---

<article class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
	<h2 class="font-serif text-2xl font-semibold">
		<a href={publicationPath(publication.slug)} class="transition-colors hover:text-slate-600 dark:hover:text-slate-300">
			{publication.name}
		</a>
	</h2>
	<p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{publication.description}</p>
	<a
		href={publicationPath(publication.slug)}
		class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-slate-900 transition-colors hover:text-slate-600 dark:text-white dark:hover:text-slate-300"
	>
		View publication
		<span aria-hidden="true">→</span>
	</a>
</article>
