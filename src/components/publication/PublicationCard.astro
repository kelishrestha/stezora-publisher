---
import type { Publication } from '../../lib/publications/types';
import { publicationPath } from '../../lib/publications';

interface Props {
	publication: Publication;
}

const { publication } = Astro.props;
---

<article class="flex flex-col rounded-xl border border-border bg-surface p-6 shadow-sm transition-shadow hover:shadow-md">
	<h2 class="font-serif text-2xl font-semibold">
		<a href={publicationPath(publication.slug)} class="transition-colors hover:text-accent-foreground">
			{publication.name}
		</a>
	</h2>
	<p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">{publication.description}</p>
	<a
		href={publicationPath(publication.slug)}
		class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-foreground transition-colors hover:text-accent-foreground"
	>
		View publication
		<span aria-hidden="true">→</span>
	</a>
</article>
