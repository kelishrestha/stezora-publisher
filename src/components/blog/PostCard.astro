---
import type { Post } from '../../lib/publications/collections';
import { postPath } from '../../lib/publications';
import { imageVariant } from '../../lib/publications/images';
import { formatDate } from '../../lib/seo/seo';
import { badgeClass, buttonClass, cardClass } from '../ui/shared/classes';

interface Props {
	post: Post;
	publicationSlug: string;
	/** Wide keeps the roomier proportions; slim is the default. */
	wide?: boolean;
	/** Render without a border (publication pages). */
	borderless?: boolean;
}

const { post, publicationSlug, wide = false, borderless = false } = Astro.props;

const href = postPath(publicationSlug, post.id);

function displayDate(date: Date): string {
	return date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<!-- HyperUI blog card: image, title, excerpt, published date, tags, CTA. -->
<article class={`group flex h-full flex-col ${cardClass({ borderless })}`}>
	{post.data.featuredImage ? (
		<a href={href} class="block" tabindex="-1" aria-hidden="true">
			<span class={`img-shell ${wide ? 'h-64' : 'h-56'} w-full`}>
				<span class="img-shell-dots" aria-hidden="true"><span></span><span></span><span></span></span>
				<img
					src={imageVariant(post.data.featuredImage, 640)}
					alt=""
					loading="lazy"
					onload="this.classList.add('loaded')"
					class="h-full w-full object-cover"
				/>
			</span>
		</a>
	) : (
		<a href={href} class="block" tabindex="-1" aria-hidden="true">
			<span
				class={`flex ${wide ? 'h-64' : 'h-56'} w-full items-center justify-center bg-accent-soft text-accent-foreground`}
			>
				<svg
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-10 opacity-60"
				>
					<path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z" />
					<line x1="16" x2="2" y1="8" y2="22" />
					<line x1="17.5" x2="9" y1="15" y2="15" />
				</svg>
			</span>
		</a>
	)}
	<div class={`flex flex-1 flex-col ${wide ? 'p-4 sm:p-6' : 'p-4'}`}>
		<h2 class={`font-serif text-lg font-semibold text-pretty leading-snug ${wide ? 'sm:text-xl' : ''}`}>
			<a href={href} class="transition-colors group-hover:text-accent-foreground">
				{post.data.title}
			</a>
		</h2>
		<dl class="mt-2 flex items-center gap-2 text-muted-foreground">
			<dt>
				<span class="sr-only">Published on</span>
				<svg
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke-width="1.5"
					stroke="currentColor"
					class="size-4"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
					/>
				</svg>
			</dt>
			<dd class="text-xs">
				<time datetime={formatDate(post.data.pubDate)}>{displayDate(post.data.pubDate)}</time>
			</dd>
		</dl>
		{post.data.tags.length > 0 && (
			<div class="mt-3 flex flex-wrap gap-1.5">
				{post.data.tags.map((tag) => (
					<span class={badgeClass('solid')}>{tag}</span>
				))}
			</div>
		)}
		<div class="mt-auto pt-5">
			<a
				href={href}
				class={buttonClass('primary')}
			>
				View post
				<span aria-hidden="true">&rarr;</span>
			</a>
		</div>
	</div>
</article>
