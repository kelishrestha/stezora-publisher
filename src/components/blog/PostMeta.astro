---
import { formatDate } from '../../lib/seo/seo';
import { slugify, tagPath } from '../../lib/publications';

interface Props {
	publicationSlug: string;
	tags: string[];
	pubDate: Date;
	updatedDate?: Date;
}

const { publicationSlug, tags, pubDate, updatedDate } = Astro.props;

function displayDate(date: Date): string {
	return date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
	<time datetime={formatDate(pubDate)}>{displayDate(pubDate)}</time>
	{updatedDate && updatedDate.getTime() > pubDate.getTime() && (
		<span aria-hidden="true">·</span>
	)}
	{updatedDate && updatedDate.getTime() > pubDate.getTime() && (
		<time datetime={formatDate(updatedDate)}>Updated {displayDate(updatedDate)}</time>
	)}
	{tags.length > 0 && (
		<span class="flex flex-wrap items-center gap-x-2">
			<span aria-hidden="true">·</span>
			{tags.map((tag) => (
				<a
					href={tagPath(publicationSlug, slugify(tag))}
					class="transition-colors hover:text-accent-foreground"
				>
					#{tag}
				</a>
			))}
		</span>
	)}
</p>