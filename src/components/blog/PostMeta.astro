---
import { formatDate } from '../../lib/seo/seo';

interface Props {
	pubDate: Date;
	updatedDate?: Date;
}

const { pubDate, updatedDate } = Astro.props;

function displayDateTime(date: Date): string {
	const day = date.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' });
	const time = date.toLocaleTimeString('en', { hour: 'numeric', minute: '2-digit' });
	return `${day} at ${time}`;
}

const wasUpdated = updatedDate && updatedDate.getTime() > pubDate.getTime();
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
	<p class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
		<svg
			aria-hidden="true"
			xmlns="http://www.w3.org/2000/svg"
			fill="none"
			viewBox="0 0 24 24"
			stroke-width="1.5"
			stroke="currentColor"
			class="size-4 shrink-0"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
			/>
		</svg>
		<span>
			Posted on <time datetime={formatDate(pubDate)}>{displayDateTime(pubDate)}</time>
		</span>
		{wasUpdated && updatedDate && (
			<span>
				&middot; Last updated on <time datetime={formatDate(updatedDate)}>{displayDateTime(updatedDate)}</time>
			</span>
		)}
	</p>
</div>
