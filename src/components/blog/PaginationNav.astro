---
interface Props {
	currentPage: number;
	totalPages: number;
	/** Page 1 lives at basePath; later pages at `${basePath}/page/<n>`. */
	basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;

function pathFor(page: number): string {
	return page === 1 ? basePath : `${basePath}/page/${page}`;
}

const pages = Array.from({ length: totalPages }, (_, index) => index + 1);
---

{
	totalPages > 1 && (
		<nav aria-label="Pagination" class="mt-10 flex justify-center">
			<ul class="flex items-center gap-1">
				<li>
					{currentPage > 1 ? (
						<a
							href={pathFor(currentPage - 1)}
							aria-label="Previous page"
							class="grid size-8 place-content-center rounded border border-border bg-surface text-foreground transition-colors hover:bg-surface-elevated"
						>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="size-4 rtl:rotate-180" viewBox="0 0 20 20" fill="currentColor">
								<path
									fill-rule="evenodd"
									d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
									clip-rule="evenodd"
								/>
							</svg>
						</a>
					) : (
						<span class="grid size-8 place-content-center rounded border border-border bg-surface text-muted-foreground opacity-50">
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="size-4 rtl:rotate-180" viewBox="0 0 20 20" fill="currentColor">
								<path
									fill-rule="evenodd"
									d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
									clip-rule="evenodd"
								/>
							</svg>
						</span>
					)}
				</li>
				{pages.map((page) => (
					<li>
						{page === currentPage ? (
							<span
								aria-current="page"
								class="grid size-8 place-content-center rounded border border-accent bg-accent text-center text-sm font-medium text-on-accent"
							>
								{page}
							</span>
						) : (
							<a
								href={pathFor(page)}
								class="grid size-8 place-content-center rounded border border-border bg-surface text-center text-sm font-medium text-foreground transition-colors hover:bg-surface-elevated"
							>
								{page}
							</a>
						)}
					</li>
				))}
				<li>
					{currentPage < totalPages ? (
						<a
							href={pathFor(currentPage + 1)}
							aria-label="Next page"
							class="grid size-8 place-content-center rounded border border-border bg-surface text-foreground transition-colors hover:bg-surface-elevated"
						>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="size-4 rtl:rotate-180" viewBox="0 0 20 20" fill="currentColor">
								<path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"
								/>
							</svg>
						</a>
					) : (
						<span class="grid size-8 place-content-center rounded border border-border bg-surface text-muted-foreground opacity-50">
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="size-4 rtl:rotate-180" viewBox="0 0 20 20" fill="currentColor">
								<path
									fill-rule="evenodd"
									d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
									clip-rule="evenodd"
								/>
							</svg>
						</span>
					)}
				</li>
			</ul>
		</nav>
	)
}
