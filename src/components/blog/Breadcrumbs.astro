---
interface Crumb {
	name: string;
	href?: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
---

<!-- HyperUI breadcrumb pattern (chevron separators) on theme tokens. -->
<nav aria-label="Breadcrumb">
	<ol class="flex flex-wrap items-center gap-1 text-sm text-muted-foreground">
		{items.map((item, index) => (
			<>
				<li>
					{item.href ? (
						<a href={item.href} class="block transition-colors hover:text-accent-foreground">
							{item.name}
						</a>
					) : (
						<span aria-current="page" class="block text-foreground">
							{item.name}
						</span>
					)}
				</li>
				{index < items.length - 1 && (
					<li class="rtl:rotate-180">
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							class="size-4"
							viewBox="0 0 20 20"
							fill="currentColor"
						>
							<path
								fill-rule="evenodd"
								d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
								clip-rule="evenodd"
							/>
						</svg>
					</li>
				)}
			</>
		))}
	</ol>
</nav>
