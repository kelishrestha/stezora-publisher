---
import type { Post } from '../../lib/publications/collections';
import PostCard from './PostCard.astro';

interface Props {
	posts: Post[];
	publicationSlug: string;
	/** Wide renders two roomy columns; slim (default) fits three on large screens. */
	wide?: boolean;
}

const { posts, publicationSlug, wide = false } = Astro.props;
---

<div class={`grid gap-4 sm:grid-cols-2 ${wide ? '' : 'lg:grid-cols-3'}`}>
	{posts.map((post) => (
		<PostCard post={post} publicationSlug={publicationSlug} wide={wide} />
	))}
</div>
