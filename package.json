{
  "name": "stezora-publisher",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "wrangler dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "types": "wrangler types",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "deploy": "pnpm build && wrangler deploy",
    "blogger:import": "tsx --env-file=.env.development scripts/blogger/import.ts",
    "blogger:oauth": "tsx --env-file=.env.development scripts/blogger/oauth.ts",
    "migrate:markdown": "tsx scripts/migrate-markdown-to-json.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "marked": "^18.0.9",
    "sanitize-html": "^2.17.6",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
