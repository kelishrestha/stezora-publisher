{
  "name": "stezora-publisher",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "wrangler dev",
    "dev:cms": "pnpm build && pnpm dev:worker",
    "prepare": "lefthook install",
    "build": "astro build",
    "prebuild": "pnpm clean && pnpm export:content",
    "clean": "rm -rf dist .astro",
    "export:content": "tsx scripts/export-content.ts",
    "preview": "astro preview",
    "astro": "astro",
    "types": "wrangler types",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "deploy": "EXPORT_CONTENT_URL=\"${EXPORT_CONTENT_URL:?EXPORT_CONTENT_URL must be set for production deploy (builds must not depend on local D1 state)}\" pnpm build && wrangler deploy",
    "blogger:import": "tsx --env-file=.env.development scripts/blogger/import.ts",
    "blogger:oauth": "tsx --env-file=.env.development scripts/blogger/oauth.ts",
    "migrate:markdown": "tsx scripts/migrate-markdown-to-json.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "better-auth:generate": "better-auth generate --config ./better-auth.config.ts --output ./worker/db/auth-schema.ts",
    "db:migrate": "wrangler d1 migrations apply stezora-app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply stezora-app-db --remote",
    "db:seed:sql": "pnpm tsx scripts/db/seed-publications.ts && pnpm tsx --env-file=.env.development scripts/db/seed-admin.ts",
    "db:seed": "mkdir -p .d1 && pnpm --silent db:seed:sql > .d1/seed.sql && wrangler d1 execute stezora-app-db --local --file .d1/seed.sql",
    "db:seed:remote": "mkdir -p .d1 && pnpm --silent db:seed:sql > .d1/seed.sql && wrangler d1 execute stezora-app-db --remote --file .d1/seed.sql",
    "db:backfill:sql": "pnpm tsx --env-file=.env.development scripts/db/import-json-to-d1.ts",
    "db:backfill": "mkdir -p .d1 && pnpm --silent db:backfill:sql > .d1/backfill.sql && wrangler d1 execute stezora-app-db --local --file .d1/backfill.sql",
    "db:backfill:remote": "mkdir -p .d1 && pnpm --silent db:backfill:sql > .d1/backfill.sql && wrangler d1 execute stezora-app-db --remote --file .d1/backfill.sql",
    "backup:content": "tsx scripts/backup/export-all.ts",
    "backup:db": "tsx scripts/backup/dump-d1.ts",
    "backup:media": "tsx scripts/backup/export-media.ts",
    "blogger:localize": "tsx --env-file=.env.development scripts/blogger/localize-images.ts",
    "neobook:sync": "tsx scripts/neobook/sync.ts",
    "deploy:media": "tsx scripts/deploy/push-media.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@iconify-json/lucide": "^1.2.126",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "analytics": "^0.8.19",
    "astro": "^7.2.0",
    "astro-icon": "^1.2.0",
    "better-auth": "^1.6.27",
    "drizzle-orm": "^0.45.2",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.6",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.186.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/parser": "^8.66.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "gray-matter": "^4.0.3",
    "lefthook": "^2.1.10",
    "miniflare": "5.20260801.1-alpha",
    "tsx": "^4.23.11",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
