{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stezora-publisher",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./dist",
		// The worker rewrites /admin/posts/:id/view and :id/edit onto the
		// static editor shells and gates every /admin page behind a session,
		// so admin requests must reach the worker instead of being served
		// directly from assets, and the worker needs the ASSETS binding.
		"binding": "ASSETS",
		"run_worker_first": ["/admin", "/admin/*", "/api/*", "/media/*"],
		"not_found_handling": "404-page"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stezora-publisher-db",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "./migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "stezora-publisher-media"
		}
	]
}
