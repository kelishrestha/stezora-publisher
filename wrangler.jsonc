{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stezora-publisher",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./dist",
		// The worker rewrites /admin/posts/:id/view and :id/edit onto the
		// static editor shells and gates every /admin page behind a session,
		// so admin requests must reach the worker instead of being served
		// directly from assets, and the worker needs the ASSETS binding.
		"binding": "ASSETS",
		"run_worker_first": [
			"/admin",
			"/admin/*",
			"/api/*",
			"/media/*"
		],
		"not_found_handling": "404-page"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stezora-app-db",
			"database_id": "6d0a3bef-a622-4b59-aa5d-da16f36b071b",
			"migrations_dir": "./migrations"
		},
		{
			"binding": "stezora_app_db",
			"database_name": "stezora-app-db",
			"database_id": "6d0a3bef-a622-4b59-aa5d-da16f36b071b"
		}
	],
	"vars": {
		// "false" removes the R2 dependency: media URLs resolve to their
		// external source (Blogger CDN) and upload/localize endpoints return
		// 503. Flip to "true" AND restore the r2_buckets binding to enable R2:
		// { "binding": "MEDIA", "bucket_name": "stezora-publisher-media" }
		"ENABLE_MEDIA_STORAGE": "false"
	}
}